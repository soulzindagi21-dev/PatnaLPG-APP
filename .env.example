# Patna LPG app: environment variables
# Copy this file to .env.local for local development.
# On Vercel, add the same keys under Project Settings > Environment Variables.
# Never commit .env.local or real values. Only this example file is committed.

# --- Supabase (Project Settings > API) ---
# Use the Mumbai (ap-south-1) region when creating the project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses row-level security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for migrations (Project Settings > Database).
# Use the pooled connection string for runtime and the direct one for migrations.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://app.patnalpg.com
NEXT_PUBLIC_APP_NAME="Patna LPG"

# Mobile-number login maps each 10-digit mobile to a hidden email on this domain,
# e.g. 9876543210@login.patnalpg.com. The domain does not need to receive mail.
AUTH_SYNTHETIC_EMAIL_DOMAIN=login.patnalpg.com
# Default password given to new customers (they can change it).
DEFAULT_CUSTOMER_PASSWORD=123456

# --- Storage (private bucket for Aadhaar and document scans) ---
SUPABASE_STORAGE_BUCKET_DOCUMENTS=customer-documents
# Lifetime of signed links to documents, in seconds.
DOCUMENT_SIGNED_URL_TTL_SECONDS=120

# --- Company details used on invoices and the payment page ---
COMPANY_NAME=
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT_NO=
COMPANY_BANK_IFSC=
COMPANY_UPI_ID=
# QR image is stored as a file in the app (public/payment-qr.png), not here.

# --- WhatsApp notifications (optional at launch) ---
# Leave empty to use staff-sent click-to-chat links instead.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Cron (Vercel cron calls protected routes with this secret) ---
CRON_SECRET=generate-a-long-random-string
